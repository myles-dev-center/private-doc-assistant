# Copy to .env and adjust. Any OpenAI-compatible endpoint works.

# --- Local (LM Studio). Nothing leaves the machine. ---
DOCASSIST_LLM_BASE_URL=http://localhost:1234/v1
DOCASSIST_LLM_MODEL=qwen3.5-9b-mtp
DOCASSIST_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# --- Local (Ollama) ---
# DOCASSIST_LLM_BASE_URL=http://localhost:11434/v1
# DOCASSIST_LLM_MODEL=qwen3:8b
# DOCASSIST_EMBED_MODEL=nomic-embed-text

# --- Cloud (OpenAI) ---
# DOCASSIST_LLM_BASE_URL=https://api.openai.com/v1
# DOCASSIST_LLM_API_KEY=sk-...
# DOCASSIST_LLM_MODEL=gpt-4.1-mini
# DOCASSIST_LLM_REASONING_EFFORT=
# DOCASSIST_EMBED_MODEL=text-embedding-3-small
# DOCASSIST_EMBED_DOC_PREFIX=
# DOCASSIST_EMBED_QUERY_PREFIX=

# Chat and embeddings can use different endpoints, e.g. cloud chat + local embeddings:
# DOCASSIST_EMBED_BASE_URL=http://localhost:1234/v1
# ...or cloud embeddings through OpenRouter:
# DOCASSIST_EMBED_BASE_URL=https://openrouter.ai/api/v1
# DOCASSIST_EMBED_API_KEY=sk-or-...
# DOCASSIST_EMBED_MODEL=openai/text-embedding-3-small

# --- Several model setups to switch between in the UI (see profiles.example.yaml) ---
# DOCASSIST_PROFILES_PATH=profiles.yaml

# --- Document type: one extraction schema per kind of document ---
# DOCASSIST_SCHEMA_PATH=schemas/agreement.yaml   # default: schemas/contract.yaml
